{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/preprinted-plane-card.schema.json",
  "title": "Source-space Preprinted Plane Composition Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "canvas", "carrier", "layers", "output"],
  "properties": {
    "version": {"const": 1},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 256},
        "height": {"type": "integer", "minimum": 256}
      }
    },
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "dye_rgb", "dye_strategy", "source_palette_evidence", "illumination", "seed"],
      "properties": {
        "material_id": {"enum": ["tight_book_cloth", "fine_linen", "dense_buckram"]},
        "dye_rgb": {"$ref": "#/$defs/rgb"},
        "dye_strategy": {
          "enum": [
            "explicit_user_palette",
            "recessive_complement",
            "analogous_shadow",
            "neutralized_source",
            "theme_directed"
          ]
        },
        "source_palette_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_rgb", "source_influence", "selection_basis"],
          "properties": {
            "source_rgb": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {"$ref": "#/$defs/rgb"}
            },
            "source_influence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_ref", "weight"],
                "properties": {
                  "source_ref": {"type": "string", "minLength": 1},
                  "weight": {"type": "number", "minimum": 0.1, "maximum": 5}
                }
              }
            },
            "selection_basis": {"type": "string", "minLength": 1}
          }
        },
        "weave_period_px": {"type": "number", "minimum": 3, "maximum": 12},
        "weave_contrast": {"type": "number", "minimum": 0, "maximum": 14},
        "fiber_noise": {"type": "number", "minimum": 0, "maximum": 12},
        "relief_strength": {"type": "number", "minimum": 0, "maximum": 0.45},
        "illumination": {"type": "number", "minimum": 0, "maximum": 0.18},
        "seed": {"type": "integer"},
        "texture_source": {"type": "string", "minLength": 1},
        "texture_source_strength": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/photo_card"},
          {"$ref": "#/$defs/spot_screenprint"}
        ]
      }
    },
    "output": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "common": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "position": {"$ref": "#/$defs/pair"},
        "rotation_degrees": {"type": "number", "minimum": -45, "maximum": 45}
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells_per_short_edge", "angle_degrees", "supersample", "dot_gain", "max_coverage", "jitter_fraction", "ink_load_variation", "edge_softness_px", "seed"],
      "properties": {
        "cells_per_short_edge": {"type": "integer", "minimum": 180, "maximum": 960},
        "angle_degrees": {"type": "number", "minimum": -45, "maximum": 45},
        "supersample": {"enum": [2, 4]},
        "dot_gain": {"type": "number", "minimum": -0.03, "maximum": 0.1},
        "max_coverage": {"type": "number", "minimum": 0.5, "maximum": 0.76},
        "jitter_fraction": {"type": "number", "minimum": 0, "maximum": 0.1},
        "ink_load_variation": {"type": "number", "minimum": 0, "maximum": 0.08},
        "edge_softness_px": {"type": "number", "minimum": 0, "maximum": 0.45},
        "dot_shape_roughness": {"type": "number", "minimum": 0, "maximum": 0.15},
        "seed": {"type": "integer"}
      }
    },
    "tone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["black_point", "white_point", "gamma", "paper_tooth_strength", "preserve_lighting", "prefilter"],
      "properties": {
        "black_point": {"type": "integer", "minimum": 0, "maximum": 120},
        "white_point": {"type": "integer", "minimum": 135, "maximum": 255},
        "gamma": {"type": "number", "minimum": 0.65, "maximum": 1.8},
        "paper_tooth_strength": {"type": "number", "minimum": 0, "maximum": 0.25},
        "preserve_lighting": {"type": "number", "minimum": 0, "maximum": 0.25},
        "prefilter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contrast", "lightness", "blur_px", "black_generation"],
          "properties": {
            "contrast": {"type": "number", "minimum": 0.75, "maximum": 1.35},
            "lightness": {"type": "number", "minimum": -0.2, "maximum": 0.2},
            "blur_px": {"type": "number", "minimum": 0, "maximum": 2},
            "black_generation": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_px", "blur_px", "opacity"],
      "properties": {
        "offset_px": {"$ref": "#/$defs/pair"},
        "blur_px": {"type": "number", "minimum": 0, "maximum": 60},
        "opacity": {"type": "number", "minimum": 0, "maximum": 0.6}
      }
    },
    "photo_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "position", "rotation_degrees", "interior_size", "crop_focal", "border_px", "paper_rgb", "ink_rgb", "paper_texture", "reproduction", "screen", "tone", "shadow"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "photo_card"},
        "source": {"type": "string", "minLength": 1},
        "position": {"$ref": "#/$defs/pair"},
        "rotation_degrees": {"type": "number", "minimum": -45, "maximum": 45},
        "interior_size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "crop_focal": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "border_px": {"type": "integer", "minimum": 4, "maximum": 160},
        "paper_rgb": {"$ref": "#/$defs/rgb"},
        "ink_rgb": {"$ref": "#/$defs/rgb"},
        "paper_texture": {"type": "number", "minimum": 0, "maximum": 3},
        "reproduction": {"enum": ["monochrome_am", "spot_duotone_am", "subtractive_cmyk_am"]},
        "channel_angles_degrees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cyan", "magenta", "yellow", "black"],
          "properties": {
            "cyan": {"type": "number", "minimum": -90, "maximum": 90},
            "magenta": {"type": "number", "minimum": -90, "maximum": 90},
            "yellow": {"type": "number", "minimum": -90, "maximum": 90},
            "black": {"type": "number", "minimum": -90, "maximum": 90}
          }
        },
        "channel_inks_rgb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cyan", "magenta", "yellow", "black"],
          "properties": {
            "cyan": {"$ref": "#/$defs/rgb"},
            "magenta": {"$ref": "#/$defs/rgb"},
            "yellow": {"$ref": "#/$defs/rgb"},
            "black": {"$ref": "#/$defs/rgb"}
          }
        },
        "spot_angles_degrees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["midtone", "shadow"],
          "properties": {
            "midtone": {"type": "number", "minimum": -90, "maximum": 90},
            "shadow": {"type": "number", "minimum": -90, "maximum": 90}
          }
        },
        "spot_inks_rgb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["midtone", "shadow"],
          "properties": {
            "midtone": {"$ref": "#/$defs/rgb"},
            "shadow": {"$ref": "#/$defs/rgb"}
          }
        },
        "spot_split": {"type": "number", "minimum": 0.35, "maximum": 0.75},
        "screen": {"$ref": "#/$defs/screen"},
        "tone": {"$ref": "#/$defs/tone"},
        "shadow": {"$ref": "#/$defs/shadow"}
      },
      "allOf": [
        {
          "if": {"properties": {"reproduction": {"const": "subtractive_cmyk_am"}}, "required": ["reproduction"]},
          "then": {"required": ["channel_angles_degrees", "channel_inks_rgb"]}
        },
        {
          "if": {"properties": {"reproduction": {"const": "spot_duotone_am"}}, "required": ["reproduction"]},
          "then": {"required": ["spot_angles_degrees", "spot_inks_rgb", "spot_split"]}
        }
      ]
    },
    "spot_screenprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "position", "rotation_degrees", "width", "palette", "ink_opacity", "substrate_imprint", "fiber_relief", "pigment_penetration", "ink_deposit_variation", "seed", "edge_softness_px"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "spot_screenprint"},
        "source": {"type": "string", "minLength": 1},
        "position": {"$ref": "#/$defs/pair"},
        "rotation_degrees": {"type": "number", "minimum": -45, "maximum": 45},
        "width": {"type": "integer", "minimum": 64},
        "palette": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/rgb"}},
        "ink_opacity": {"type": "number", "minimum": 0.55, "maximum": 1},
        "substrate_imprint": {"type": "number", "minimum": 0, "maximum": 0.35},
        "fiber_relief": {"type": "number", "minimum": 0, "maximum": 0.45},
        "pigment_penetration": {"type": "number", "minimum": 0, "maximum": 0.4},
        "ink_deposit_variation": {"type": "number", "minimum": 0, "maximum": 0.24},
        "seed": {"type": "integer"},
        "edge_softness_px": {"type": "number", "minimum": 0, "maximum": 1.2}
      }
    }
  }
}
